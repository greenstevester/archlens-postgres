{
  "name": "archlens-postgres",
  "version": "2.0.0",
  "private": true,
  "description": "Document a PostgreSQL schema and review its design in one run.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "review": "node --disable-warning=ExperimentalWarning scripts/archlens.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "libpg-query": "17.7.4",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
